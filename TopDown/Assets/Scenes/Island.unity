  m_Script: {fileID: 11500000, guid: a614fe02195a746e6ab6386ab3bdb68f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialouge
  dialogue:
  - lines:
    - where did you go
    - i swear i had you right in my hand
    - you were so so red
    - in petals
    - and only grew in these woods
  - lines:
    - oh?
    - what is this little one?
  - lines:
    - what happened to you
    - you never looked like this
    - i think you're a fraud...
  - lines:
    - oh my red gods!
    - my tulip!
    - love of my death!
    - little one, whatever can i do to repay you...
